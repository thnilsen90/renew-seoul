# Copy to .env.local (or set in the hosting provider's dashboard).
# .env.local is ignored by git, so real values never get committed.

# The Shopify store that handles cart and checkout. Change this when the
# new site takes over renewseoul.com and Shopify moves to a subdomain.
VITE_SHOPIFY_STORE_URL=https://renewseoul.com

# Private-preview PIN (4–8 digits). When set, visitors must enter it before
# they see the site. Leave empty locally to skip the screen. Required on Vercel.
SITE_PIN=
